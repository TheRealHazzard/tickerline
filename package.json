{
  "name": "tickerline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A real-time crypto market dashboard: live prices over WebSocket, candlestick charts and simple indicator signals",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
